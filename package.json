{
  "name": "patrick-pan-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "images": "node scripts/images.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "3.1.0",
    "autoprefixer": "10.4.21",
    "lighthouse": "13.4.1",
    "postcss": "8.5.6",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.17",
    "vite": "4.5.14"
  },
  "packageManager": "npm@11.9.0"
}
